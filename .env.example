# RFD Platform Environment Variables

# Backend
PORT=3001
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# RFD Configuration
RFD_PATH=/app/RFD.exe
GAMES_DIR=/app/games
THUMBNAILS_DIR=/app/thumbnails
RFD_LOG_DIR=/app/logs

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Server Host (for join links)
SERVER_HOST=127.0.0.1

# Production
NODE_ENV=production